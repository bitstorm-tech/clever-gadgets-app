{
  "name": "clever-gadgets",
  "packageManager": "bun@1.4.2",
  "private": true,
  "scripts": {
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "dev": "bun scripts/dev.ts",
    "migrate": "bun run --filter '@clever-gadgets/server' migrate",
    "seed": "bun run --filter '@clever-gadgets/server' seed",
    "typecheck": "tsc -p tsconfig.json && bun run --filter '*' typecheck",
    "test": "bun test",
    "build": "bun run --filter '@clever-gadgets/web' build",
    "ci": "bun run typecheck && bun run test && bun run build"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "6.0.3"
  }
}
