# Copy to apps/server/.env to override defaults. All values are optional in development.

# development | test | production
APP_ENV=development
PORT=3100
# Required in production. In development/test, the database from docker-compose.yml is used by default.
DATABASE_URL=postgres://clevergadgets:clevergadgets@localhost:5434/clevergadgets
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# text (readable lines via pino-pretty) | json. Default: text in development, json otherwise.
LOG_FORMAT=text
