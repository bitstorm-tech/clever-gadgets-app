# Nach apps/server/.env kopieren, um Standardwerte zu überschreiben. In der Entwicklung sind alle Werte optional.

# development | test | production
APP_ENV=development
PORT=3100
# In Produktion Pflicht. In Entwicklung/Test gilt standardmäßig die Datenbank aus docker-compose.yml.
DATABASE_URL=postgres://clevergadgets:clevergadgets@localhost:5434/clevergadgets
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# text (lesbare Zeilen via pino-pretty) | json. Standard: text in Entwicklung, sonst json.
LOG_FORMAT=text
